# ===== Garmin 数据源选择 =====
# api   - 国际区 Garmin Connect OAuth API (需 GARMIN_SECRET_STRING)
# local - 本地导出目录 (国区 CDP 管线已导出的 fit, 需 GARMIN_CN_EXPORT_DIR)  ← 国区推荐
# cdp   - 国区 CDP 直连 (直连已登录 garmin.cn 的 Chrome, 需 GARMIN_CN_CDP)
# 不设则自动探测: 有 token→api; 有导出目录→local; 否则→cdp
# GARMIN_SOURCE=local

# ===== 方案 A: 国际区 API =====
# 获取: python3 scripts/garmin/get_garmin_token.py (需 garminconnect/garth, 国际区账号)
# GARMIN_SECRET_STRING=

# ===== 方案 B: 国区本地目录 (推荐, 配合 cft/garmin 管线) =====
# cft/garmin/cn_export.py 导出目录 (含 fit/*.fit 与 activities.json)
# 默认自动探测 ../cft/garmin/export/fit
# GARMIN_CN_EXPORT_DIR=../cft/garmin/export/fit

# ===== 方案 C: 国区 CDP 直连 =====
# 已登录 garmin.cn 的 Chrome CDP 端口 (cft/garmin 反向隧道: u2:9995 → ZSXF)
# 会话失效时运行 cft/garmin/ws_login.py 重登
# GARMIN_CN_CDP=http://127.0.0.1:9995

# ===== 心率参数 (可选, 用于 VDOT 跑力计算与心率区间) =====
MAX_HR=190
RESTING_HR=55
