# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# e2e-build.sh 的 tsconfig 备份哨兵（正常由 trap 还原，SIGKILL 时可能残留）
/.tsconfig.e2e.bak

# next.js
/.next/
/.next-e2e/
/.next.prev/
/.deploy.lock
/.next-e2e.prev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt

# Temporary FIT files
*.fit
tmp/
temp/

# Backup files
*.backup

# FIT cache (avoid re-downloading)
.cache/

# Runtime database (large, backup locally)
# /app/data整体不入库：生产为指向块存储的软链，git不遍历软链目录，
# 其下的.gitkeep会被误判为删除并挡住pull --rebase（2026-09-13实证）
/app/data
app/data/*.db
app/data/*.db-*
app/data/*.db.bak.*
app/data/.backups/
# 部署脚本构建期临时把 app/data 软链改名到此（见 scripts/deploy-prod.sh stash_data_link），
# 构建失败/被强杀时会残留；不忽略会让 git status 出现噪音、误提交进仓库。
/app/data.link.bak

# e2e 夹具库 (由 scripts/testing/make-fixture-db.js 生成, CI 按需重建)
tests/fixtures/*.db

# Playwright 产物
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# MCP server build output
mcp-server/dist/
